# Required: secret used to sign login tokens (at least 32 random characters)
JWT_SECRET=change-me-to-a-long-random-string-0123456789

# Optional: a real PostgreSQL. Without it, the API uses PGlite and stores data in ./.data
# DATABASE_URL=postgres://user:password@localhost:5432/relay

# Optional: Claude answers customers. Without it, a free demo responder quotes the knowledge base.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# Most AI calls per day before falling back to the demo responder (200 by default in demo mode)
# AI_DAILY_LIMIT=200

# Business name used in the AI's instructions
# BUSINESS_NAME=Aurora Dental Clinic

# Optional: the real WhatsApp Cloud API (Meta). Without these, only the built-in simulator is used.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Shows the "Try the demo" button and creates the demo account and knowledge base on start
# DEMO_MODE=true

# Proxies in front of the API (Render: 3), so rate limits count visitors and not the proxy
# TRUST_PROXY_HOPS=1

# PORT=3333
